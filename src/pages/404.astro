---
/**
 * GitHub Pages sirve esta misma página para cualquier dirección que no exista, en los dos idiomas.
 * Va en español con el texto en inglés debajo.
 */
import Base from '../layouts/Base.astro';
import { ruta } from '../i18n/rutas.ts';
import { textos } from '../i18n/textos.ts';

const es = textos('es');
const en = textos('en');
---

<Base idioma="es" titulo={`${es.noEncontrada.titulo} | Azeta Cargo`} descripcion={es.noEncontrada.texto} pagina="inicio" indexable={false} sinAlternas>
  <div class="contenedor no-encontrada">
    <p class="no-encontrada__codigo" aria-hidden="true">404</p>
    <h1>{es.noEncontrada.h1}</h1>
    <p class="entrada">{es.noEncontrada.texto}</p>
    <div class="no-encontrada__acciones">
      <a class="boton boton--primario" href={ruta('es', 'tienda')}>{es.noEncontrada.tienda}</a>
      <a class="boton" href={ruta('es', 'inicio')}>{es.noEncontrada.inicio}</a>
    </div>
    <div class="no-encontrada__otro" lang="en">
      <h2>{en.noEncontrada.h1}</h2>
      <p>{en.noEncontrada.texto}</p>
      <a class="enlace" href={ruta('en', 'tienda')}>{en.noEncontrada.tienda}</a>
    </div>
  </div>
</Base>

<style>
  .no-encontrada {
    display: grid;
    gap: var(--espacio-4);
    justify-items: start;
    padding-top: var(--espacio-8);
  }

  .no-encontrada__codigo {
    font-family: var(--fuente-codigo);
    font-size: var(--texto-l);
    color: var(--color-gris);
    letter-spacing: 0.2em;
  }

  .no-encontrada h1 {
    font-size: var(--texto-4xl);
  }

  .no-encontrada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    margin-top: var(--espacio-3);
  }

  .no-encontrada__otro {
    display: grid;
    gap: var(--espacio-2);
    justify-items: start;
    margin-top: var(--espacio-6);
    padding-top: var(--espacio-5);
    border-top: var(--linea);
  }

  .no-encontrada__otro h2 {
    font-size: var(--texto-l);
  }
</style>
