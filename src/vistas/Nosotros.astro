---
import Icono from '../componentes/Icono.astro';
import PaginaTexto from '../layouts/PaginaTexto.astro';
import { negocio } from '../config/negocio.ts';
import type { Idioma } from '../lib/catalogo.ts';
import { ruta } from '../i18n/rutas.ts';
import { textos } from '../i18n/textos.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
---

<PaginaTexto idioma={idioma} pagina="nosotros" titulo={t.nosotros.titulo} descripcion={t.nosotros.descripcion}>
  <div class="prosa">
    {t.nosotros.parrafos.map((p) => <p>{p}</p>)}
  </div>

  <section class="nosotros__pasos" aria-labelledby="titulo-pasos">
    <h2 class="rotulo" id="titulo-pasos">{t.inicio.comoComprar}</h2>
    <ol role="list">
      {
        t.inicio.pasos.map((paso, i) => (
          <li>
            <span class="nosotros__numero" aria-hidden="true">
              {i + 1}
            </span>
            <span>{paso}</span>
          </li>
        ))
      }
    </ol>
    <div class="nosotros__acciones">
      <a class="boton boton--primario" href={ruta(idioma, 'tienda')}>{t.inicio.verTienda}</a>
      <a class="boton" href={ruta(idioma, 'mayoreo')}>{t.inicio.cotizar}</a>
    </div>
  </section>

  <section class="nosotros__marketplace" aria-labelledby="titulo-marketplace">
    <h2 id="titulo-marketplace">{t.nosotros.marketplace}</h2>
    <p>{t.nosotros.marketplaceTexto}</p>
    <a class="enlace" href={negocio.marketplace} rel="noopener">
      azeta.app <Icono nombre="externo" tamano={16} class="nosotros__externo" />
    </a>
  </section>
</PaginaTexto>

<style>
  .nosotros__pasos {
    margin-top: var(--espacio-7);
    padding-top: var(--espacio-3);
    border-top: 2px solid var(--color-marino);
  }

  .nosotros__pasos h2 {
    color: var(--color-marino);
  }

  .nosotros__pasos ol {
    margin: var(--espacio-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .nosotros__pasos li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--espacio-3);
    align-items: baseline;
    padding: var(--espacio-3) 0;
    border-bottom: var(--linea);
  }

  .nosotros__numero {
    font-family: var(--fuente-titulos);
    font-weight: 600;
    font-size: var(--texto-2xl);
    line-height: 1;
    color: var(--color-marino);
  }

  .nosotros__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    margin-top: var(--espacio-5);
  }

  .nosotros__marketplace {
    display: grid;
    gap: var(--espacio-3);
    justify-items: start;
    margin-top: var(--espacio-7);
    padding: var(--espacio-5);
    background: var(--color-fondo-imagen);
  }

  .nosotros__marketplace h2 {
    font-size: var(--texto-l);
  }

  .nosotros__marketplace a {
    display: inline-flex;
    gap: var(--espacio-1);
    align-items: center;
  }
</style>
