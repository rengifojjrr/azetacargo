---
import Icono from '../componentes/Icono.astro';
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import Base from '../layouts/Base.astro';
import type { Idioma } from '../lib/catalogo.ts';
import type { NombreIcono } from '../lib/iconos.ts';
import { obtenerCatalogo } from '../lib/sitio.ts';
import { ruta } from '../i18n/rutas.ts';
import { textos } from '../i18n/textos.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const { categorias, productos } = obtenerCatalogo();
const marcados = productos.filter((p) => p.destacado && p.disponible);
const destacados = (marcados.length >= 4 ? marcados : productos.filter((p) => p.disponible)).slice(0, 8);
const cuantos = (categoria: string) => productos.filter((p) => p.categoria === categoria).length;
---

<Base idioma={idioma} titulo={t.inicio.titulo} descripcion={t.sitio.descripcion} pagina="inicio">
  <section class="portada contenedor" aria-labelledby="titulo-portada">
    <div class="portada__texto">
      <h1 class="portada__titulo" id="titulo-portada">{t.inicio.h1}</h1>
      <p class="entrada portada__entrada">{t.inicio.entrada}</p>
      <div class="portada__acciones">
        <a class="boton boton--primario" href={ruta(idioma, 'tienda')}>{t.inicio.verTienda}</a>
        <a class="boton" href={ruta(idioma, 'mayoreo')}>{t.inicio.cotizar}</a>
      </div>
    </div>
    <aside class="pasos" aria-labelledby="como-comprar">
      <h2 class="rotulo pasos__titulo" id="como-comprar">{t.inicio.comoComprar}</h2>
      <ol class="pasos__lista" role="list">
        {
          t.inicio.pasos.map((paso, i) => (
            <li>
              <span class="pasos__numero" aria-hidden="true">
                {i + 1}
              </span>
              <span>{paso}</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="contenedor bloque" aria-labelledby="titulo-categorias">
    <div class="encabezado-seccion">
      <h2 id="titulo-categorias">{t.inicio.categorias}</h2>
    </div>
    <ul class="celdas categorias" role="list">
      {
        categorias.map((c) => (
          <li>
            <a class="categoria" href={ruta(idioma, 'categoria', c.id)}>
              <Icono nombre={c.icono as NombreIcono} tamano={32} class="categoria__icono" />
              <span class="categoria__nombre">{c.nombre[idioma]}</span>
              {c.descripcion[idioma] && <span class="categoria__descripcion">{c.descripcion[idioma]}</span>}
              <span class="rotulo categoria__cuenta">{t.catalogo.productos(cuantos(c.id))}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="categoria categoria--todo" href={ruta(idioma, 'tienda')}>
          <Icono nombre="cuadricula" tamano={32} class="categoria__icono" />
          <span class="categoria__nombre">{t.cabecera.todo}</span>
          <span class="rotulo categoria__cuenta">{t.catalogo.productos(productos.length)}</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="contenedor bloque" aria-labelledby="titulo-destacados">
    <div class="encabezado-seccion">
      <h2 id="titulo-destacados">{t.inicio.destacados}</h2>
      <a href={ruta(idioma, 'tienda')}>{t.inicio.verTodo}</a>
    </div>
    <ul class="celdas" role="list">
      {
        destacados.map((p) => (
          <li>
            <TarjetaProducto producto={p} idioma={idioma} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="banda-mayoreo banda-final sobre-marino" aria-labelledby="titulo-mayoreo">
    <div class="contenedor banda-mayoreo__reticula">
      <div class="banda-mayoreo__texto">
        <h2 id="titulo-mayoreo">{t.inicio.mayoreoTitulo}</h2>
        <p>{t.inicio.mayoreoTexto}</p>
        <a class="boton boton--claro" href={ruta(idioma, 'mayoreo')}>{t.inicio.mayoreoBoton}</a>
      </div>
      <ul class="servicios" role="list">
        {
          t.servicios.map((s) => (
            <li>
              <Icono nombre={s.icono as NombreIcono} tamano={28} />
              <span class="servicios__titulo">{s.titulo}</span>
              <span class="servicios__texto">{s.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Portada: el título grande es la única pieza llamativa de la página */
  .portada {
    display: grid;
    gap: var(--espacio-6);
    padding-block: var(--espacio-7) var(--espacio-seccion);
  }

  .portada__titulo {
    font-size: 2.375rem;
    line-height: 0.98;
    letter-spacing: 0.005em;
    max-width: 15ch;
  }

  .portada__entrada {
    margin-top: var(--espacio-5);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    margin-top: var(--espacio-6);
  }

  .portada__acciones .boton {
    flex: 1 1 auto;
  }

  @media (min-width: 768px) {
    .portada__acciones .boton {
      flex: 0 0 auto;
    }
  }

  .pasos {
    align-self: end;
    border-top: 2px solid var(--color-marino);
    padding-top: var(--espacio-3);
  }

  .pasos__titulo {
    color: var(--color-marino);
  }

  .pasos__lista {
    margin: var(--espacio-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .pasos__lista li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--espacio-3);
    align-items: baseline;
    padding: var(--espacio-3) 0;
    border-bottom: var(--linea);
  }

  .pasos__numero {
    font-family: var(--fuente-titulos);
    font-weight: 600;
    font-size: var(--texto-2xl);
    line-height: 1;
    color: var(--color-marino);
    font-variant-numeric: tabular-nums;
  }

  .bloque {
    padding-bottom: var(--espacio-seccion);
  }

  /* Categorías: celdas con ícono */
  .categoria {
    display: grid;
    align-content: start;
    gap: var(--espacio-2);
    height: 100%;
    min-height: 8.5rem;
    padding: var(--espacio-4);
    color: var(--color-marino);
    text-decoration: none;
  }

  .categoria:hover {
    background: var(--color-fondo-imagen);
  }

  .categoria:focus-visible {
    outline-offset: -2px;
  }

  .categoria :global(.categoria__icono) {
    margin-bottom: var(--espacio-2);
  }

  .categoria__nombre {
    font-family: var(--fuente-titulos);
    font-weight: 600;
    font-size: var(--texto-m);
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .categoria__descripcion {
    display: none;
    font-size: var(--texto-s);
    color: var(--color-gris);
  }

  .categoria__cuenta {
    margin-top: auto;
    padding-top: var(--espacio-2);
  }

  .categoria--todo {
    background: var(--color-fondo-imagen);
  }

  .categoria--todo:hover {
    background: var(--color-linea);
  }

  /* Banda de mayoreo */
  .banda-mayoreo {
    padding-block: var(--espacio-seccion);
  }

  .banda-mayoreo__reticula {
    display: grid;
    gap: var(--espacio-6);
  }

  .banda-mayoreo__texto {
    display: grid;
    gap: var(--espacio-4);
    justify-items: start;
    align-content: start;
  }

  .banda-mayoreo__texto p {
    max-width: 34ch;
    font-size: var(--texto-l);
    color: var(--color-sobre-marino-suave);
  }

  .servicios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-linea-sobre-marino);
    border-left: 1px solid var(--color-linea-sobre-marino);
  }

  .servicios li {
    display: grid;
    align-content: start;
    gap: var(--espacio-2);
    padding: var(--espacio-4);
    border-right: 1px solid var(--color-linea-sobre-marino);
    border-bottom: 1px solid var(--color-linea-sobre-marino);
  }

  .servicios__titulo {
    margin-top: var(--espacio-2);
    font-family: var(--fuente-titulos);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .servicios__texto {
    font-size: var(--texto-s);
    color: var(--color-sobre-marino-suave);
  }

  @media (min-width: 768px) {
    .portada__titulo {
      font-size: var(--texto-5xl);
    }

    .categoria {
      min-height: 11rem;
      padding: var(--espacio-5);
    }

    .categoria__descripcion {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .portada {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--separacion);
      padding-block: var(--espacio-8) var(--espacio-seccion);
    }

    .portada__texto {
      grid-column: 1 / span 8;
    }

    .portada__titulo {
      font-size: var(--texto-6xl);
      max-width: 16ch;
    }

    .pasos {
      grid-column: 9 / span 4;
    }

    .banda-mayoreo__reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--separacion);
    }

    .banda-mayoreo__texto {
      grid-column: 1 / span 4;
    }

    .servicios {
      grid-column: 6 / span 7;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
