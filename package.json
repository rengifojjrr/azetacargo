{
  "name": "azetacargo",
  "private": true,
  "version": "0.1.0",
  "description": "Tienda en línea de Azeta Cargo (Miami): catálogo, carrito y pedidos por WhatsApp.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "validar": "tsx scripts/validar-catalogo.ts",
    "prebuild": "npm run validar",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint .",
    "test": "vitest run --project unidad",
    "test:compilado": "vitest run --project compilado",
    "test:e2e": "playwright test",
    "probar-todo": "npm run check && npm test && npm run build && npm run test:compilado && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "astro": "^7.4.11",
    "csv-parse": "^7.0.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
